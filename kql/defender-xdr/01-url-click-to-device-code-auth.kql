let ClickToSigninWindow = 7m;
let InterruptToSuccessWindow = 5m;
let SuspiciousClicks =
    UrlClickEvents
    | where Timestamp > ago(24h)
    | extend ClickedThrough = tolower(tostring(IsClickedThrough)) in ("true", "1")
    | where ActionType in ("ClickAllowed", "UrlScanInProgress", "UrlErrorPage")
        or ClickedThrough
    | where UrlChain has_any ("microsoft.com/devicelogin", "login.microsoftonline.com/common/oauth2/deviceauth")
        or Url has_any ("microsoft.com/devicelogin", "login.microsoftonline.com/common/oauth2/deviceauth")
    | extend AccountUpn = tolower(AccountUpn)
    | where isnotempty(AccountUpn)
    | project ClickTime = Timestamp, AccountUpn,
        Url, UrlChain, NetworkMessageId, ActionType, ClickedThrough;
let DeviceCodeInterrupts =
    EntraIdSignInEvents
    | where Timestamp > ago(24h)
    | where ErrorCode == 50199
    | extend AccountUpn = tolower(AccountUpn)
    | where isnotempty(AccountUpn) and isnotempty(SessionId)
    | project InterruptTime = Timestamp, AccountUpn, SessionId;
let DeviceCodeSuccesses =
    EntraIdSignInEvents
    | where Timestamp > ago(24h)
    | where ErrorCode == 0
    | extend AccountUpn = tolower(AccountUpn)
    | where isnotempty(AccountUpn) and isnotempty(SessionId)
    | project SuccessTime = Timestamp, AccountUpn, SessionId,
        IPAddress, Application, ApplicationId, RiskLevelAggregated;
let DeviceCodeSignins =
    DeviceCodeInterrupts
    | join kind=inner DeviceCodeSuccesses on AccountUpn, SessionId
    | where SuccessTime between (InterruptTime .. InterruptTime + InterruptToSuccessWindow)
    | summarize FirstInterrupt=min(InterruptTime), FirstSignin=min(SuccessTime),
        LastSignin=max(SuccessTime), IPs=make_set(IPAddress, 10),
        Apps=make_set(Application, 10), AppIds=make_set(ApplicationId, 10),
        RiskLevels=make_set(RiskLevelAggregated, 10)
        by AccountUpn, SessionId;
SuspiciousClicks
| join kind=inner DeviceCodeSignins on AccountUpn
| where FirstSignin between (ClickTime .. ClickTime + ClickToSigninWindow)
| project FirstSignin, FirstInterrupt, ClickTime, AccountUpn, Url, UrlChain,
    ActionType, ClickedThrough, IPs, Apps, AppIds, RiskLevels,
    NetworkMessageId, SessionId
