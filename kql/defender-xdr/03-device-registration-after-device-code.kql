let Window = 2h;
let DeviceCodeInterrupts =
    EntraIdSignInEvents
    | where Timestamp > ago(24h)
    | where ErrorCode == 50199
    | extend AccountObjectId = tolower(AccountObjectId)
    | where isnotempty(AccountObjectId) and isnotempty(SessionId)
    | project AccountObjectId, AccountUpn = tolower(AccountUpn), SessionId,
        InterruptTime = Timestamp;
let DeviceCodeSuccesses =
    EntraIdSignInEvents
    | where Timestamp > ago(24h)
    | where ErrorCode == 0
    | extend AccountObjectId = tolower(AccountObjectId)
    | where isnotempty(AccountObjectId) and isnotempty(SessionId)
    | project AccountObjectId, SessionId, DeviceCodeTime = Timestamp,
        SignInIP = IPAddress, Application, ApplicationId;
let SuspiciousDeviceCodeSessions =
    DeviceCodeInterrupts
    | join kind=inner DeviceCodeSuccesses on AccountObjectId, SessionId
    | where DeviceCodeTime between (InterruptTime .. InterruptTime + 5m)
    | summarize DeviceCodeTime=max(DeviceCodeTime),
        FirstInterrupt=min(InterruptTime),
        SignInIPs=make_set(SignInIP, 10),
        Apps=make_set(Application, 10),
        AppIds=make_set(ApplicationId, 10)
        by AccountObjectId, AccountUpn, SessionId;
CloudAppEvents
| where Timestamp > ago(24h)
| where AccountDisplayName =~ "Device Registration Service"
| where ActionType =~ "Add registered owner to device."
// Microsoft's documented shape uses ObjectId for the UPN and Target[1].ID
// for the registering user's Entra object ID. Other event shapes are not inferred.
// Confirm this shape against retained tenant rows before operationalizing.
// https://github.com/Azure/Azure-Sentinel/blob/master/Hunting%20Queries/Microsoft%20365%20Defender/Persistence/riskySignInToDeviceRegistration.yaml
| extend RegistrationAccountUpn = tolower(tostring(RawEventData.ObjectId)),
    RegistrationUserObjectId = tolower(tostring(RawEventData.Target[1].ID))
| where RegistrationUserObjectId matches regex @"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
| where RegistrationUserObjectId != "00000000-0000-0000-0000-000000000000"
| join kind=inner SuspiciousDeviceCodeSessions
    on $left.RegistrationUserObjectId == $right.AccountObjectId
| where Timestamp between (DeviceCodeTime .. DeviceCodeTime + Window)
| project Timestamp, DeviceCodeTime, FirstInterrupt,
    UserAccountObjectId = RegistrationUserObjectId,
    AccountUpn, RegistrationAccountUpn, SessionId, ActionType, IPAddress,
    RegisteredObjectName = ObjectName, RegisteredObjectId = ObjectId,
    RawEventData
| order by Timestamp desc
