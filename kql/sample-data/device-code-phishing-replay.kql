let SigninLogs = datatable(TimeGenerated:datetime, UserId:string, UserPrincipalName:string, ResultType:string, ResultDescription:string, CorrelationId:string, SessionId:string, IPAddress:string, AppDisplayName:string, AppId:string, UserAgent:string, AuthenticationProtocol:string)
[
    datetime(2026-04-25T14:00:00Z), "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa", "alex@contoso.com", "50199", "User is required to authorize device code", "corr-001", "sess-001", "203.0.113.50", "LAB - Nine Lives Device Code Telemetry", "11111111-1111-4111-8111-111111111111", "NineLivesLab/1.0", "deviceCode",
    datetime(2026-04-25T14:03:12Z), "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa", "alex@contoso.com", "0", "Success", "corr-001", "sess-001", "203.0.113.50", "LAB - Nine Lives Device Code Telemetry", "11111111-1111-4111-8111-111111111111", "NineLivesLab/1.0", "deviceCode",
    datetime(2026-04-25T14:45:22Z), "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb", "casey@contoso.com", "0", "Success", "corr-002", "sess-002", "198.51.100.8", "Microsoft Azure CLI", "04b07795-8ddb-461a-bbee-02f9e1bf7b46", "AzureCLI", "deviceCode"
];
let Window = 5m;
// Only immutable application IDs suppress alerts. Display names are attacker-controlled.
let ApprovedDeviceCodeAppIds = dynamic([
    "04b07795-8ddb-461a-bbee-02f9e1bf7b46",
    "1950a258-227b-4e31-a9cf-717495945fc2"
]);
let Interrupts =
    SigninLogs
    | where ResultType == "50199" or ResultDescription has "50199"
    | extend UserKey = tolower(UserId)
    | where isnotempty(UserKey) and isnotempty(CorrelationId)
    | project InterruptTime = TimeGenerated, UserKey, UserPrincipalName,
        CorrelationId, SessionId, IPAddress, AppDisplayName, AppId, UserAgent;
let Successes =
    SigninLogs
    | where ResultType == "0"
    | extend UserKey = tolower(UserId)
    | where isnotempty(UserKey) and isnotempty(CorrelationId)
    | project SuccessTime = TimeGenerated, UserKey, CorrelationId,
        SuccessSessionId = SessionId, SuccessIP = IPAddress,
        SuccessApp = AppDisplayName, SuccessAppId = AppId,
        SuccessUserAgent = UserAgent;
Interrupts
| join kind=inner Successes on UserKey, CorrelationId
| where SuccessTime between (InterruptTime .. InterruptTime + Window)
| extend EffectiveAppId = iff(isnotempty(SuccessAppId), SuccessAppId, AppId)
| where isempty(EffectiveAppId) or EffectiveAppId !in~ (ApprovedDeviceCodeAppIds)
| project SuccessTime, InterruptTime, UserPrincipalName,
    AppDisplayName, AppId, SuccessApp, SuccessAppId, EffectiveAppId,
    IPAddress, SuccessIP, UserAgent, SuccessUserAgent,
    CorrelationId, SessionId, SuccessSessionId
